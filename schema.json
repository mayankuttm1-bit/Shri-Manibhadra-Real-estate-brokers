{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShriManibhadraBackendSchema",
  "description": "JSON Schemas for Shri Manibhadra Real Estate Brokers Platform",
  "definitions": {
    "Coordinates": {
      "type": "object",
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "required": ["lat", "lng"],
      "additionalProperties": false
    },
    "Property": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^prop-[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 5, "maxLength": 150 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "category": { 
          "type": "string", 
          "enum": ["residential", "commercial", "plots", "luxury"] 
        },
        "type": { 
          "type": "string", 
          "enum": ["Flat", "Villa", "Duplex", "Shop", "Office", "Showroom", "Plot", "Land", "Farmhouse"] 
        },
        "price": { "type": "number", "minimum": 100000 },
        "priceDisplay": { "type": "string" },
        "pricePerSqft": { "type": "string" },
        "areaSqft": { "type": "number", "minimum": 50 },
        "bedrooms": { "type": "integer", "minimum": 0, "maximum": 20 },
        "bathrooms": { "type": "integer", "minimum": 0, "maximum": 20 },
        "locality": { "type": "string", "minLength": 3, "maxLength": 100 },
        "address": { "type": "string", "minLength": 5, "maxLength": 255 },
        "coordinates": { "$ref": "#/definitions/Coordinates" },
        "images": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "minItems": 1
        },
        "description": { "type": "string", "minLength": 10 },
        "amenities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": { 
          "type": "string", 
          "enum": ["active", "under_offer", "sold"] 
        },
        "isFeatured": { "type": "boolean" },
        "views": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "title", "slug", "category", "type", "price", 
        "priceDisplay", "areaSqft", "locality", "address", 
        "coordinates", "images", "status", "isFeatured"
      ],
      "additionalProperties": false
    },
    "User": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^usr-[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "email": { "type": "string", "format": "email" },
        "passwordHash": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff", "client"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "passwordHash", "role", "createdAt"],
      "additionalProperties": false
    },
    "Inquiry": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^inq-[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 15 },
        "email": { "type": "string", "format": "email" },
        "propertyId": { "type": "string" },
        "propertyTitle": { "type": "string" },
        "serviceInterest": { "type": "string" },
        "message": { "type": "string", "maxLength": 1000 },
        "source": { "type": "string", "enum": ["whatsapp_click", "web_form", "call_click"] },
        "status": { "type": "string", "enum": ["new", "contacted", "followup", "closed"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "ipAddress": { "type": "string" }
      },
      "required": ["id", "name", "phone", "source", "status", "timestamp"],
      "additionalProperties": false
    },
    "Analytics": {
      "type": "object",
      "properties": {
        "totalViews": { "type": "integer", "minimum": 0 },
        "totalInquiries": { "type": "integer", "minimum": 0 },
        "dailyViews": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "views": { "type": "integer", "minimum": 0 }
            },
            "required": ["date", "views"]
          }
        },
        "categoryViews": {
          "type": "object",
          "properties": {
            "residential": { "type": "integer" },
            "commercial": { "type": "integer" },
            "plots": { "type": "integer" },
            "luxury": { "type": "integer" }
          },
          "required": ["residential", "commercial", "plots", "luxury"]
        },
        "localityInterest": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["totalViews", "totalInquiries", "dailyViews", "categoryViews", "lastUpdated"],
      "additionalProperties": false
    }
  }
}
